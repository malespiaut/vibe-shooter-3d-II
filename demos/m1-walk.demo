# M1 walk: raw-input tour of maps/m1test.vmap (determinism demo, roadmap.md).
# Start room (2,2) facing north -> north, east through the corridor into the
# SE hall, north up the corridor into the NE sky courtyard, across it
# between the pillars to its north wall, then turn around.
vsdemo 1
level 1
skill 2
seed 0
map m1test

wait 10
in 53 127 0 0 -        # walk north to the corridor row (y ~ 8.5)
in 8 0 0 -2048 -       # turn right 90 degrees: face east
in 50 127 0 0 R        # run east through the corridor into the hall
in 8 0 0 2048 -        # face north
in 27 127 0 0 -        # walk north to the hall's top row
in 8 0 0 -2048 -       # face east
in 35 127 0 0 -        # walk east to the north corridor (x ~ 16.5)
in 8 0 0 2048 -        # face north
in 25 127 0 0 R        # run north into the courtyard (y ~ 16.5)
in 8 0 0 -2048 -       # face east
in 26 127 0 0 -        # walk east between the pillars (x ~ 19.5)
in 8 0 0 2048 -        # face north
in 55 127 0 0 -        # walk to the courtyard's north wall
in 16 0 0 2048 -       # turn around: face south
wait 20
