# M1 walk: tour of maps/m1test.vmap (determinism demo, roadmap.md), written
# with high-level commands so it survives movement tuning.
# Start room (2,2) -> east through the corridor into the SE hall (waypoint
# `hall`) -> north up the corridor into the NE sky courtyard, between the
# pillars (waypoint `courtyard`) -> its north wall -> back west through the
# west corridor into the NW dark room -> south into the start room.
vsdemo 1
level 1
skill 2
seed 0
map m1test

wait 10
goto @hall
expect tile=16,6
goto @courtyard
expect tile=19,18
goto 19 22             # courtyard north wall
face 270               # turn around: face south
wait 10
goto 4 20              # NW dark room, via the west corridor
expect tile=4,20
goto 2 2               # back to the start, through the room's south door
expect tile=2,2
face 90
wait 20
expect health=100
