# Weapon test (#65): maps/weapontest.vmap. The pistol kills the Mutt
# straight ahead, the player picks up the Scattergun and kills the other two
# with one shot each. Ends with expect lines on the kill counter.
# Since the enemy AI (#67) the pistol shots wake the other two Mutts, which
# advance and shoot back: the scattergun shots aim where they stand then.
vsdemo 1
level 1
skill 2
seed 0
map weapontest

expect kills=0
fire 40                 # pistol (in hand at start): Mutt at 12,4, 8 u east
expect kills=1
goto 4 2                # walk over the Scattergun pickup
weapon 3                # 10-tic switch while walking
goto 6 3
face 7 6                # the Mutt from 8,7, now winding up at 7,6
fire 1                  # one 7-pellet shot
expect kills=2
face 7 2                # the Mutt from 10,1, now at 7,2
fire 33                 # one shot once the 32-tic refire allows it
expect kills=3
wait 10
expect kills=3
expect health>0
