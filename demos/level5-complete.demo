clear 10
wait 30
clear 10
goto 28 12
face 90
use
wait 32
clear 10
goto 28 12
goto 28 13
clear 10
wait 20
clear 10
goto 28 14
clear 10
goto 28 16
clear 10
goto 28 16
# Grinder Hall: the gantry Dachshunds shell the floor.
clear 14
goto 28 17
clear 14
goto 26 19
clear 16
wait 30
clear 16
goto 23 22
goto 23 17
goto 28 19
clear 16
expect kills=22
# Timed door sprint across the sludge (Fish Snack on the way).
goto 22 20
face 180
use
wait 32
goto 28 21
goto 33 22
goto 33 20
goto 35 20
goto 38 18
goto 36 18
goto 37 23              # Lance: the riveted wall (37,35) slides, 12 tiles north
weapon 6
wait 40                 # the Mastiff walks into the vault
face 90
clear 16
wait 30
clear 16
expect kills=25
goto 37 30
goto 37 38
goto 35 38
# Violet door: the Packaging Line squad faces away; open with the Lance.
goto 36 33
face 180
use
wait 32
