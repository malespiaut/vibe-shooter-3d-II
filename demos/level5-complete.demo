# Level 5, Kibble Refinery completion (#177) on maps/level5.vmap (layout and
# enemies in maps/src/level5.txt), skill 2, no god, from the --warp default
# inventory (100 health, Claws + Ankh Pistol, 50 charges): the pistol until
# the Lance. High-level commands only (goto, face, use, clear, fire).
# Barrel chains in the Sludge Pits -> Control Tower squad -> blue door ->
# Grinder Hall gantry Dachshunds + timed-door sprint -> Lance Vault Mastiff
# -> violet door -> Packaging Line Mastiff and squad -> EXIT.
# goto ignores DAMAGE cells and never opens doors or fights: the walkways are
# walked with explicit corners, doors opened by hand, clear before corridors.
vsdemo 1
level 5
skill 2
seed 0
weapon 2
# Sludge Pits: the first shot is at the barrel line next to Mutt group A.
goto 9 4
goto 12 4
face 15 8               # barrel chain (15,8)-(15,9)-(15,10)
fire 13
wait 10
expect kills=3
goto 16 4
face 19 12              # barrel pair (19,12)-(19,13), Mutt group B
fire 13
wait 10
expect kills=5
# Back off to the walkway mouth and let the far side come.
goto 12 4
clear 16
wait 30
clear 16
goto 12 2
goto 12 4
goto 16 4
goto 16 9
goto 17 10
goto 16 9
goto 16 4
goto 22 4
clear 14
goto 24 1
goto 22 4
goto 22 12
goto 25 12              # Fish Snack
clear 14
expect kills=9
# Control Tower: open the door, step back, fight the squad through it.
goto 25 9
face 0
use
wait 6
goto 22 9
face 26 9
clear 12
wait 40
clear 12
wait 40
clear 12
goto 25 9
face 0
use
wait 32
goto 27 9
clear 12
goto 30 9
clear 12
goto 33 12
goto 33 9
goto 32 4
goto 31 4
goto 27 4
