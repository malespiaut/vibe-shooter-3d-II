# level_eg.vmus: levels 1-2 (Egyptian quarter), docs/design/audio.md Music.
# Original composition for this project. Mood: driving, sandstone, harp-like plucks.
# D "Egyptian" pentatonic (D E G A C), the title's motif (D A G A C A) on the lead.
# Channels: 0 lead, 1 harp 16th-note arpeggios, 2 bass, 3 drums.
# Tempo 4: 4 rows per beat = 131 BPM, a pattern is 4 bars = 7.31 s.
vmus 1
tempo 4

inst 01 square   vol=36 a=1 d=6 s=40 r=6 duty=64    # lead, 25% duty
inst 02 triangle vol=64 a=0 d=0 s=64 r=2            # bass
inst 03 triangle vol=64 a=0 d=5 s=0                 # kick: pitch drops with D7f
inst 04 noise    vol=36 a=0 d=2 s=0                 # closed hat
inst 05 noise    vol=56 a=0 d=6 s=0                 # snare
inst 06 noise    vol=40 a=0 d=4 s=0 mode=1          # metallic clank
inst 07 pluck    vol=60 a=0 d=0 s=64 r=10 damp=250  # harp pluck
inst 08 square   vol=28 a=4 d=12 s=34 r=12 duty=128 # pad (arpeggiated)
inst 09 pluck    vol=60 a=0 d=0 s=64 r=16 damp=256  # long harp, lead in the break

