# ending.vmus: ending and credits.
# Original composition for this project (docs/design/audio.md, Music).
# Mood: the title theme, slow and happy. Same five notes as the title
# (D E G A C), heard from C instead of D, so they sit as C major pentatonic
# over C, F, Am and G chords: the melody is the title's, the light is new.
# Channels: 0 lead, 1 harp/pad, 2 bass, 3 soft drums.
# Tempo 7: 4 rows per beat = 75 BPM, one pattern = 64 x 7 / 35 = 12.8 s.
vmus 1
tempo 7

inst 01 triangle vol=56 a=2 d=10 s=48 r=12          # flute lead
inst 02 pluck    vol=56 a=0 d=0 s=64 r=16 damp=255  # harp
inst 03 square   vol=26 a=4 d=16 s=34 r=14 duty=128 # pad (arpeggiated major chords)
inst 04 triangle vol=60 a=0 d=0 s=64 r=4            # bass
inst 05 triangle vol=44 a=0 d=5 s=0                 # soft kick: pitch drops with D7f
inst 06 noise    vol=18 a=0 d=2 s=0                 # hat
inst 07 noise    vol=22 a=0 d=10 s=0 mode=1         # chime
inst 08 square   vol=32 a=1 d=8 s=40 r=10 duty=64   # bright lead, 25% duty (as the title)

