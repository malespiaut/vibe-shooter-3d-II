# level_tomb.vmus: level 4, the tomb.
# Original composition for this project (docs/design/audio.md, Music).
# Mood: sparse, low drones, distant percussion. D "Egyptian" pentatonic
# (D E G A C), the title motif played slowly on a hollow flute and a far harp.
# Channels: 0 flute/reed pad, 1 harp, 2 drone bass, 3 distant drums.
# Tempo 6: 4 rows per beat = 87.5 BPM, one pattern = 64 x 6 / 35 = 10.97 s.
vmus 1
tempo 6

inst 01 triangle vol=56 a=24 d=0 s=64 r=40          # drone: slow swell
inst 02 square   vol=22 a=40 d=60 s=40 r=40 duty=32 # reed pad, 12.5% duty, thin
inst 03 pluck    vol=52 a=0 d=0 s=64 r=24 damp=252  # far harp
inst 04 triangle vol=40 a=0 d=10 s=0                # distant thud: pitch falls with D40
inst 05 noise    vol=22 a=3 d=14 s=0                # sand hiss / brushed tom
inst 06 noise    vol=18 a=0 d=12 s=0 mode=1         # far metallic clank
inst 07 triangle vol=50 a=6 d=24 s=44 r=24          # hollow flute

