# title.vmus: Vibe Shooter 3D II title and menu theme.
# Original composition for this project (docs/design/audio.md, Music).
# D "Egyptian" pentatonic (D E G A C) over a mechanical beat.
# Channels: 0 lead, 1 harp/pad, 2 bass, 3 drums. 105 BPM at 4 rows per beat.
vmus 1
tempo 5

inst 01 square   vol=40 a=1 d=6 s=40 r=6 duty=64   # lead, 25% duty
inst 02 triangle vol=64 a=0 d=0 s=64 r=2           # bass
inst 03 triangle vol=64 a=0 d=5 s=0               # kick: pitch drops with D7f
inst 04 noise    vol=40 a=0 d=2 s=0               # closed hat
inst 05 noise    vol=56 a=0 d=6 s=0               # snare
inst 06 noise    vol=44 a=0 d=4 s=0 mode=1        # metallic clank
inst 07 pluck    vol=60 a=0 d=0 s=64 r=12 damp=255 # harp pluck
inst 08 square   vol=30 a=3 d=10 s=36 r=10 duty=128 # pad (arpeggiated)

