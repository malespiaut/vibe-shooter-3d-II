inst 04 noise    vol=58 a=0 d=6 s=0                 # snare
inst 05 noise    vol=28 a=0 d=1 s=0                 # hat
inst 06 noise    vol=46 a=0 d=4 s=0 mode=1          # anvil clank (metallic)
inst 07 noise    vol=30 a=8 d=24 s=0 mode=1         # steam release
inst 08 square   vol=28 a=0 d=3 s=0 duty=64         # chord stab, arpeggiated

