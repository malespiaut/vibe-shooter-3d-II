FROM docker.io/archlinux:latest

RUN pacman -Syu --noconfirm --needed \
      base-devel git github-cli nodejs npm gcc clang cmake ninja sdl3 \
      python python-pillow python-numpy python-wxpython blender \
      xorg-server-xvfb imagemagick tmux jq sudo \
 && pacman -Scc --noconfirm

RUN npm i -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code && claude --version

# Aseprite from AUR, built as a throwaway user (own layer: slow, retried alone)
RUN useradd -m builder \
 && echo 'builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/builder \
 && su builder -c 'cd ~ && git clone https://aur.archlinux.org/aseprite.git && cd aseprite && makepkg -si --noconfirm' \
 && userdel -r builder && rm -f /etc/sudoers.d/builder \
 && pacman -Scc --noconfirm && rm -rf /tmp/*

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
