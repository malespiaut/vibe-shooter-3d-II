#!/usr/bin/env bash
# Fake gh: reads JSON fixtures from $FIXTURES, logs every call to $FIXTURES/calls.log.
printf '%s\n' "$*" >> "$FIXTURES/calls.log"
jqf=. num=
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[i]} in
    --jq) jqf=${args[i+1]} ;;
    [0-9]*) [[ -z $num && ${args[i]} =~ ^[0-9]+$ ]] && num=${args[i]} ;;
  esac
done
case "$1 $2" in
  "issue list") src=$FIXTURES/issues.json ;;
  "pr list") src=$FIXTURES/prs.json ;;
  "issue view") jq ".[] | select(.number == $num)" "$FIXTURES/issues.json" | jq -r "$jqf"; exit ;;
  "pr view") jq ".[] | select(.number == $num)" "$FIXTURES/prs.json" | jq -r "$jqf"; exit ;;
  api*) src=$FIXTURES/api/$(printf '%s' "$2" | tr -c 'A-Za-z0-9' _).json ;;
  *) exit 0 ;; # writes (edit, comment, close) are only logged
esac
if [[ -f $src ]]; then jq -r "$jqf" "$src"; else echo '[]' | jq -r "$jqf"; fi
